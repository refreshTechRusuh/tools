# ============================================================
# .env.example — Template env untuk lokal dev
# Copy file ini ke masing-masing service repo sebagai .env
# Ganti nilai yang kosong sesuai environment kamu
# ============================================================

# Infra (sesuai docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=rusuh_booking
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_TIMEOUT_SECONDS=5

VALKEY_ADDR=localhost:6379
VALKEY_PASSWORD=
VALKEY_TLS=false

# Kafka: pakai port 29092 (PLAINTEXT_HOST, host-accessible)
KAFKA_BROKERS=localhost:29092
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS=false
KAFKA_CONSUMER_GROUP=worker-service

# JWT — shared secret antara queue-service dan booking/payment service
# WAJIB sama persis di semua service dan queue-service (BE-1)
ACCESS_TOKEN_SECRET=

# Midtrans sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_ENV=sandbox

# Gmail SMTP (App Password — buat di myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=Rusuh Booking Tiket <noreply@gmail.com>

# Dukcapil mock (URL dari BE-1 / queue-service)
DUKCAPIL_BASE_URL=http://localhost:8085
DUKCAPIL_TIMEOUT_MS=3000
DUKCAPIL_FAIL_OPEN=true

# SSE
SSE_HEARTBEAT_SECONDS=30

# Log
LOG_LEVEL=debug
LOG_FORMAT=text

# App ports (tiap service override ini sendiri)
# booking-service: APP_PORT=8081
# event-service:   APP_PORT=8082
# payment-service: APP_PORT=8083
